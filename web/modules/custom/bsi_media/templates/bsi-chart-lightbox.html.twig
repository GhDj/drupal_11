<div class="bsi-chart-lightbox">
  {% if section_title %}
    <h2 class="bsi-chart-lightbox__title">
      {{ section_title }}
    </h2>
  {% endif %}

  <div class="bsi-chart-lightbox__chart">
    {{ media_view }}
  </div>

  <div class="bsi-grid">
    <div class="bsi-grid-indented">
      {% if body %}
        <div class="bsi-chart-lightbox__body">
          {{ body }}
        </div>
      {% endif %}
    </div>
  </div>

</div>
