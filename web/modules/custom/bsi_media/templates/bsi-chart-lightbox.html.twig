<div class="bsi-chart-lightbox">
  {% if media_view %}
    <div class="bsi-chart-lightbox__chart">
      {{ media_view }}
    </div>
  {% endif %}

  <div class="bsi-grid">
    <div class="bsi-grid-indented">
      {% if body %}
        <div class="bsi-chart-lightbox__body bsi-bodytext">
          {{ body }}
        </div>
      {% endif %}
    </div>
  </div>

</div>
