<?php

declare(strict_types=1);

use Drupal\Core\Access\AccessResult;
use Drupal\Core\Form\FormStateInterface;
use Drupal\block\BlockInterface;

/**
 * Implements hook_theme().
 */
function bsi_csn_theme(): array {
  return [
    'csn_branding' => [
      'variables' => [
        'bsi_logo' => NULL,
        'bsi_logo_mobile' => NULL,
        'bsi_url' => NULL,
        'csn_dashboard_url' => NULL,
      ],
    ],
  ];
}

/**
 * Implements hook_block_access().
 *
 * Hides the regular site branding block on CSN pages.
 */
function bsi_csn_block_access(BlockInterface $block, string $operation, $account): AccessResult {
  if ($operation === 'view' && $block->getPluginId() === 'system_branding_block') {
    /** @var \Drupal\bsi_csn\CsnContextChecker $checker */
    $checker = \Drupal::service('bsi_csn.context_checker');
    if ($checker->isCsnPage()) {
      return AccessResult::forbidden('CSN pages use the CSN branding block.')
        ->addCacheContexts(['route']);
    }
  }
  return AccessResult::neutral();
}

/**
 * Implements hook_form_FORM_ID_alter() for block_form.
 *
 * Removes the visibility conditions UI for the CSN branding block, since
 * visibility is handled programmatically via blockAccess().
 * This prevents Drupal from saving stale conditions (e.g. book_level)
 * that would interfere with the block's access logic.
 */
function bsi_csn_form_block_form_alter(array &$form, FormStateInterface $form_state): void {
  $block = $form_state->getFormObject()->getEntity();
  if ($block->getPluginId() === 'bsi_csn_branding') {
    $form['visibility']['#access'] = FALSE;
    $form['visibility_note'] = [
      '#type' => 'item',
      '#title' => t('Visibility'),
      '#markup' => t('This block is automatically shown only on CSN group content pages. Visibility is managed in code and cannot be changed here.'),
      '#weight' => 80,
    ];
  }
}
