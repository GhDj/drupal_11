{#
/**
 * @file
 * Template for the CSN branding block (CSN logo only).
 *
 * The BSI logo is rendered by the main branding block.
 * This block renders only the CSN logo on the right side.
 *
 * Available variables:
 * - csn_dashboard_url: URL the CSN logo links to.
 */
#}
<div class="bsi-csn-branding">
  {% if csn_dashboard_url %}
    <div class="bsi-csn-branding__csn-logo">
      <a href="{{ csn_dashboard_url }}" class="bsi-csn-branding__link">
        <img src="" alt="{{ 'Cyber Security Network'|t }}" />
      </a>
    </div>
  {% else %}
    <div class="bsi-csn-branding__csn-logo">
      <img src="" alt="{{ 'Cyber Security Network'|t }}" />
    </div>
  {% endif %}
</div>
