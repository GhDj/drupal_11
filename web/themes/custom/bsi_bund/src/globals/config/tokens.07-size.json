{
  "sizeBase": "4px",
  "size": {
    "4xs": "#{calc($size-base * 0.5)}",
    "3xs": "#{calc($size-base * 1)}",
    "2xs": "#{calc($size-base * 2)}",
    "xs": "#{calc($size-base * 3)}",
    "sm": "#{calc($size-base * 4)}",
    "md": "#{calc($size-base * 5)}",
    "lg": "#{calc($size-base * 6)}",
    "xl": "#{calc($size-base * 8)}",
    "2xl": "#{calc($size-base * 10)}",
    "3xl": "#{calc($size-base * 12)}",
    "4xl": "#{calc($size-base * 14)}",
    "5xl": "#{calc($size-base * 16)}",
    "6xl": "#{calc($size-base * 18)}",
    "7xl": "#{calc($size-base * 20)}",
    "8xl": "#{calc($size-base * 40)}"
  }
}
