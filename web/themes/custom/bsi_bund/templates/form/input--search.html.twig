{#
/**
 * @file
 * Theme override for an 'input' #type form element.
 *
 * Available variables:
 * - attributes: A list of HTML attributes for the input element.
 * - children: Optional additional rendered elements.
 *
 * @see \Drupal\Core\Form\FormPreprocess::preprocessInput()
 * @see claro_preprocess_input()
 */
#}
<input {{ attributes.removeClass([
  'form-text',
  'form-element',
  'form-element--api-search-api-autocomplete',
  'ui-autocomplete-input',
  'form-element--type-text',
]).addClass('bsi-searchbar__input')
.setAttribute('placeholder', 'Enter a search term'|t) }}/>
<div class="claro-autocomplete__message hidden" data-drupal-selector="autocomplete-message">{{ autocomplete_message }}</div>
