{#
/**
 * @file
 * Theme override for the Global Search block display.
 *
 * Wires Drupal's views output to the bsi-searchfilter + bsi-search-result
 * Storybook design patterns.
 *
 * @see views--search.html.twig
 */
#}
{%
  set classes = [
    'view',
    'view-' ~ id|clean_class,
    'view-id-' ~ id,
    'view-display-id-' ~ display_id,
    dom_id ? 'js-view-dom-id-' ~ dom_id,
  ]
%}
<div{{ attributes.addClass(classes) }}>
  {{ title_prefix }}
  {% if title %}
    {{ title }}
  {% endif %}
  {{ title_suffix }}

  {# Filter area: searchfilter pattern #}
  {% if exposed %}
    <div class="bsi-searchfilter">
      <div class="bsi-searchfilter__inner">
        {# Result count inside filter box #}
        {% if header %}
          <p class="bsi-searchfilter__text">
            {{ header }}
          </p>
        {% endif %}

        <hr />

        {# Mobile filter toggle — must precede __top for CSS sibling selector #}
        <button class="bsi-searchfilter__toggle js-searchfilter-toggle" type="button" aria-expanded="true">
          {{ 'Filter'|t }}
        </button>

        {# Filter dropdowns (without sort) #}
        <div class="bsi-searchfilter__top">
          {{ exposed|without('sort_bef_combine') }}
        </div>

        {# Active filter pills + reset #}
        <div class="bsi-searchfilter__bottom js-searchfilter-bottom"></div>
      </div>
    </div>
  {% endif %}

  {# Results area: search-result pattern #}
  {% if rows or empty %}
    <div class="bsi-search-result">
      <div class="bsi-search-result__inner">
        {# Sort dropdown in the results head #}
        {% if exposed['sort_bef_combine'] %}
          <div class="bsi-search-result__head">
            <div class="bsi-search-dropdown bsi-search-dropdown--sort">
              {{ exposed['sort_bef_combine'] }}
            </div>
          </div>
        {% endif %}

        {% if rows %}
          <div class="view-content">
            {{ rows }}
          </div>
        {% elseif empty %}
          <div class="view-empty">
            {{ empty }}
          </div>
        {% endif %}

        {% if pager %}
          {{ pager }}
        {% endif %}
      </div>
    </div>
  {% endif %}

  {% if footer %}
    <div class="view-footer">
      {{ footer }}
    </div>
  {% endif %}
</div>
