{#
/**
 * @file
 * Theme override for the Global Search block display.
 *
 * Layout order (matching Figma full-top-block.png):
 * 1. Searchbar (full width, search icon)
 * 2. Result count text
 * 3. Dotted separator
 * 4. Filter dropdowns
 * 5. Active filter pills + reset
 *
 * The searchbar and filters are inside the same <form>, but the result
 * count (header) is a separate Views area. CSS order + display:contents
 * on the form interleaves them in the correct visual order.
 */
#}
{%
  set classes = [
    'view',
    'view-' ~ id|clean_class,
    'view-id-' ~ id,
    'view-display-id-' ~ display_id,
    dom_id ? 'js-view-dom-id-' ~ dom_id,
  ]
%}
<div{{ attributes.addClass(classes) }}>
  {{ title_prefix }}
  {% if title %}
    {{ title }}
  {% endif %}
  {{ title_suffix }}

  {% if exposed %}
    <div class="bsi-searchfilter bsi-searchfilter--global">
      <div class="bsi-searchfilter__inner">
        {# Form (display:contents) — searchbar gets order:1, filters get order:4 #}
        {{ exposed|without('sort_bef_combine') }}

        {# Result count — order:2 (after searchbar, before separator) #}
        {% if header %}
          <div class="bsi-searchfilter__text">
            {{ header }}
          </div>
        {% endif %}

        {# Dotted separator — order:3 #}
        <hr class="bsi-searchfilter__separator" />

        {# Mobile filter toggle — order:4 (same as filters) #}
        <button class="bsi-searchfilter__toggle js-searchfilter-toggle" type="button" aria-expanded="true">
          {{ 'Filter'|t }}
        </button>

        {# Active filter pills — order:5 #}
        <div class="bsi-searchfilter__bottom js-searchfilter-bottom"></div>
      </div>
    </div>
  {% endif %}

  {# Results area #}
  {% if rows or empty %}
    <div class="bsi-search-result">
      <div class="bsi-search-result__inner">
        {% if exposed['sort_bef_combine'] %}
          <div class="bsi-search-result__head">
            <div class="bsi-search-dropdown bsi-search-dropdown--sort">
              {{ exposed['sort_bef_combine'] }}
            </div>
          </div>
        {% endif %}

        {% if rows %}
          <div class="view-content">
            {{ rows }}
          </div>
        {% elseif empty %}
          <div class="view-empty">
            {{ empty }}
          </div>
        {% endif %}

        {% if pager %}
          {{ pager }}
        {% endif %}
      </div>
    </div>
  {% endif %}

  {% if footer %}
    <div class="view-footer">
      {{ footer }}
    </div>
  {% endif %}
</div>
