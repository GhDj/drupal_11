{#
/**
 * @file
 * Theme override for the Global Search block display.
 *
 * Layout matches the Figma design:
 * 1. Searchbar (full width, search icon)
 * 2. Result count
 * 3. Dotted separator
 * 4. Filter dropdowns (custom multi-select)
 * 5. Active filter pills + reset
 * 6. Sort dropdown (right-aligned in results)
 * 7. Result list
 * 8. Pagination
 */
#}
{%
  set classes = [
    'view',
    'view-' ~ id|clean_class,
    'view-id-' ~ id,
    'view-display-id-' ~ display_id,
    dom_id ? 'js-view-dom-id-' ~ dom_id,
  ]
%}
<div{{ attributes.addClass(classes) }}>
  {{ title_prefix }}
  {% if title %}
    {{ title }}
  {% endif %}
  {{ title_suffix }}

  {% if exposed %}
    <div class="bsi-searchfilter bsi-searchfilter--flat">
      <div class="bsi-searchfilter__inner">
        {# Exposed form renders: searchbar, result count, separator, filters, actions #}
        {{ exposed|without('sort_bef_combine') }}

        {# Result count — placed after form via CSS order #}
        {% if header %}
          <div class="bsi-searchfilter__text">
            {{ header }}
          </div>
        {% endif %}

        {# Dotted separator #}
        <hr class="bsi-searchfilter__separator" />

        {# Mobile filter toggle #}
        <button class="bsi-searchfilter__toggle js-searchfilter-toggle" type="button" aria-expanded="true">
          {{ 'Filter'|t }}
        </button>

        {# Active filter pills (populated by JS) #}
        <div class="bsi-searchfilter__bottom js-searchfilter-bottom"></div>
      </div>
    </div>
  {% endif %}

  {# Results area #}
  {% if rows or empty %}
    <div class="bsi-search-result">
      <div class="bsi-search-result__inner">
        {% if exposed['sort_bef_combine'] %}
          <div class="bsi-search-result__head">
            <div class="bsi-search-dropdown bsi-search-dropdown--sort">
              {{ exposed['sort_bef_combine'] }}
            </div>
          </div>
        {% endif %}

        {% if rows %}
          <div class="view-content">
            {{ rows }}
          </div>
        {% elseif empty %}
          <div class="view-empty">
            {{ empty }}
          </div>
        {% endif %}

        {% if pager %}
          {{ pager }}
        {% endif %}
      </div>
    </div>
  {% endif %}

  {% if footer %}
    <div class="view-footer">
      {{ footer }}
    </div>
  {% endif %}
</div>
