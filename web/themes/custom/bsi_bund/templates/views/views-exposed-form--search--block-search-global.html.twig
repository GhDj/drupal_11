{#
/**
 * @file
 * Exposed form for global search.
 *
 * Renders fulltext search and facet filters (checkboxes with counts).
 * The sort_bef_combine element is excluded here — the parent view template
 * places it separately in the bsi-search-result area.
 */
#}

{# Fulltext search input #}
{% if form.search is defined %}
  <div class="form-item-search">
    {{ form.search }}
  </div>
{% endif %}

{# Facet filter checkboxes — each renders as a collapsible fieldset #}
{% set facet_keys = ['type', 'topics', 'audiences', 'year'] %}
{% for key in facet_keys %}
  {% if form[key] is defined %}
    <div class="bsi-searchfilter__filter">
      {{ form[key] }}
    </div>
  {% endif %}
{% endfor %}

{# Hidden form elements #}
{{ form.form_build_id }}
{{ form.form_token }}
{{ form.form_id }}

{# Actions (Apply / Reset) #}
{% if form.actions is defined %}
  <div class="bsi-searchfilter__actions">
    {{ form.actions }}
  </div>
{% endif %}
