{#
/**
 * @file
 * Exposed form for global search — matches Figma design.
 *
 * 1. Searchbar with search icon (bsi-searchbar)
 * 2. Filter grid with custom multi-select dropdowns
 * 3. Hidden form elements + submit
 */
#}

{# Searchbar — full width, bsi-searchbar styling #}
{% if form.search is defined %}
  <div class="bsi-searchbar">
    {{ form.search }}
    <button type="submit" class="bsi-button bsi-button--tertiary bsi-searchbar__button" aria-label="{{ 'Suche'|t }}">
      {% include '@bsi_bund/components/icon.twig' with {
        name: 'search',
        decorative: true,
      } only %}
    </button>
  </div>
{% endif %}

{# Filter grid — custom multi-select dropdowns #}
<div class="bsi-searchfilter__top">
  {% set facet_keys = ['type', 'topics', 'audiences', 'year'] %}
  {% for key in facet_keys %}
    {% if form[key] is defined %}
      <div class="bsi-multiselect js-multiselect" data-filter-key="{{ key }}">
        {{ form[key] }}
      </div>
    {% endif %}
  {% endfor %}
</div>

{# Hidden form elements #}
{{ form.form_build_id }}
{{ form.form_token }}
{{ form.form_id }}

{# Hidden submit for JS to trigger #}
{% if form.actions is defined %}
  <div class="bsi-searchfilter__actions visually-hidden">
    {{ form.actions }}
  </div>
{% endif %}
