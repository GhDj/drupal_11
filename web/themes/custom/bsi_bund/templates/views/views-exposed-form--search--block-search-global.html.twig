{#
/**
 * @file
 * Exposed form for global search.
 *
 * Matches the Storybook searchfilter layout:
 * 1. Searchbar — full width (above the grid)
 * 2. Filter grid — 4 columns at lg, each as bsi-search-dropdown
 * 3. Actions — Apply / Reset below the grid
 *
 * sort_bef_combine is NOT rendered here — the parent view template
 * places it in the bsi-search-result area.
 */
#}

{# Searchbar — full width, above the filter grid #}
{% if form.search is defined %}
  <div class="form-item-search">
    {{ form.search }}
  </div>
{% endif %}

{# Filter grid — 4 columns matching bsi-searchfilter__top #}
<div class="bsi-searchfilter__top">
  {% set facet_keys = ['type', 'topics', 'audiences', 'year'] %}
  {% for key in facet_keys %}
    {% if form[key] is defined %}
      <div class="bsi-search-dropdown">
        {{ form[key] }}
      </div>
    {% endif %}
  {% endfor %}
</div>

{# Hidden form elements #}
{{ form.form_build_id }}
{{ form.form_token }}
{{ form.form_id }}

{# Actions (Apply / Reset) #}
{% if form.actions is defined %}
  <div class="bsi-searchfilter__actions">
    {{ form.actions }}
  </div>
{% endif %}
