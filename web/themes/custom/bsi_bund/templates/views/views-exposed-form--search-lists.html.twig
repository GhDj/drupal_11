{#
/**
 * @file
 * Exposed form for search_lists (dynamic list).
 * Separates filters, actions and sort.
 * Actions (Apply) and sort are grouped on the right.
 */
#}

{# Filters (without sort and actions) #}
<div class="filters-wrapper">
  {{ form|without('sort_bef_combine', 'actions') }}
</div>

{# Actions + Sort — right-aligned together #}
<div class="actions-sort-wrapper">
  {{ form.actions }}

  {% if form.sort_bef_combine is defined %}
    <div class="bsi-search-dropdown bsi-search-dropdown--sort">
      {{ form.sort_bef_combine }}
    </div>
  {% endif %}
</div>
