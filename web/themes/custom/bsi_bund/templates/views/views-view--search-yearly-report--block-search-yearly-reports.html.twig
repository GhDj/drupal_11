{#
/**
 * @file
 * Theme override for the Search Yearly Report block display.
 *
 * Renders the exposed search form and, after AJAX submission,
 * the search results in the bsi-search-result design pattern.
 */
#}
{%
  set classes = [
    'view',
    'view-' ~ id|clean_class,
    'view-id-' ~ id,
    'view-display-id-' ~ display_id,
    dom_id ? 'js-view-dom-id-' ~ dom_id,
  ]
%}

<div{{ attributes.addClass(classes) }}>
  {% if exposed %}
    <div class="view-filters">
      {{ exposed }}
    </div>
  {% endif %}

  {% if rows or empty %}
    <div class="bsi-search-result">
      <div class="bsi-search-result__inner">
        {% if header %}
          <div class="bsi-search-result__head">
            {{ header }}
          </div>
        {% endif %}

        {% if rows %}
          {{ rows }}
        {% elseif empty %}
          <div class="view-empty">
            {{ empty }}
          </div>
        {% endif %}

        {% if pager %}
          {{ pager }}
        {% endif %}
      </div>
    </div>
  {% endif %}
</div>
