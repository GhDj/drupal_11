{#
/**
 * @file
 * Theme override for the Search Yearly Report block display.
 *
 * Based on views--search.html.twig but wraps results in the
 * bsi-search-result design pattern from the search-result component.
 *
 * @see views--search.html.twig
 */
#}
{%
  set classes = [
    'view',
    'view-' ~ id|clean_class,
    'view-id-' ~ id,
    'view-display-id-' ~ display_id,
    dom_id ? 'js-view-dom-id-' ~ dom_id,
  ]
%}
<div{{ attributes.addClass(classes) }}>
  {{ title_prefix }}
  {% if title %}
    {{ title }}
  {% endif %}
  {{ title_suffix }}

  {% if exposed %}
    <div class="view-filters">
      {{ exposed|without('sort_bef_combine') }}
    </div>
    {% if exposed['sort_bef_combine'] %}
      {{ exposed['sort_bef_combine'] }}
    {% endif %}
  {% endif %}

  {% if rows or empty %}
    <div class="bsi-search-result">
      <div class="bsi-search-result__inner">
        {% if header %}
          <div class="bsi-search-result__head">
            {{ header }}
          </div>
        {% endif %}

        {% if rows %}
          <div class="view-content">
            {{ rows }}
          </div>
        {% elseif empty %}
          <div class="view-empty">
            {{ empty }}
          </div>
        {% endif %}

        {% if pager %}
          {{ pager }}
        {% endif %}
      </div>
    </div>
  {% endif %}
</div>
