{#
  Generic search view template — matches Storybook search layout.

  Wraps exposed form in bsi-searchfilter box and results in bsi-search-result.
  Used by search_pages, search_media, search_events, search_lists views.
  Global search and yearly report have their own more specific templates.
#}
{%
  set classes = [
  'view',
  'view-' ~ id|clean_class,
  'view-id-' ~ id,
  'view-display-id-' ~ display_id,
  dom_id ? 'js-view-dom-id-' ~ dom_id,
]
%}
<div{{ attributes.addClass(classes) }}>
  {{ title_prefix }}
  {{ title_suffix }}

  {% if exposed %}
    <div class="bsi-searchfilter bsi-searchfilter--global">
      <div class="bsi-searchfilter__inner">
        {# Title #}
        {% set search_title = title|default(view.getTitle()) %}
        {% if search_title %}
          <h2 class="bsi-searchfilter__title">{{ search_title }}</h2>
        {% endif %}

        {# Result count #}
        {% if header %}
          <div class="bsi-searchfilter__text">
            {{ header }}
          </div>
        {% endif %}

        {# Full form (searchbar + filters + sort) #}
        {{ exposed }}

        {# Dotted separator #}
        <hr class="bsi-searchfilter__separator" />

        {# Mobile filter toggle #}
        <button class="bsi-searchfilter__toggle js-searchfilter-toggle" type="button" aria-expanded="true">
          {{ 'Filter'|t }}
        </button>

        {# Active filter pills #}
        <div class="bsi-searchfilter__bottom js-searchfilter-bottom"></div>
      </div>
    </div>
  {% endif %}

  {% if attachment_before %}
    <div class="attachment attachment-before">
      {{ attachment_before }}
    </div>
  {% endif %}

  {# Results area #}
  {% if rows or empty %}
    <div class="bsi-search-result">
      <div class="bsi-search-result__inner">
        {% if rows %}
          <div class="view-content">
            {{ rows }}
          </div>
        {% elseif empty %}
          <div class="view-empty">
            {{ empty }}
          </div>
        {% endif %}

        {% if pager %}
          {{ pager }}
        {% endif %}
      </div>
    </div>
  {% endif %}

  {% if attachment_after %}
    <div class="attachment attachment-after">
      {{ attachment_after }}
    </div>
  {% endif %}
  {% if more %}
    {{ more }}
  {% endif %}
  {% if footer %}
    <div class="view-footer">
      {{ footer }}
    </div>
  {% endif %}
  {% if feed_icons %}
    <div class="feed-icons">
      {{ feed_icons }}
    </div>
  {% endif %}
</div>
