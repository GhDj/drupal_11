{%
  set classes = [
    'view',
    'view-' ~ id|clean_class,
    'view-id-' ~ id,
    'view-display-id-' ~ display_id,
    dom_id ? 'js-view-dom-id-' ~ dom_id,
  ]
%}
<div{{ attributes.addClass(classes) }}>
  {# Full form including sort — sort stays inside <form> for submission.
     The exposed form template (views-exposed-form.html.twig) separates
     filters and sort into .filters-wrapper and .sort-wrapper divs. #}
  {% if exposed %}
    {{ exposed }}
  {% endif %}

  {% if rows %}
    <div class="bsi-block__content">
      {{ rows }}
    </div>
  {% elseif empty %}
    <div class="view-empty">
      {{ empty }}
    </div>
  {% endif %}

  {% if pager %}
    {{ pager }}
  {% endif %}
</div>
