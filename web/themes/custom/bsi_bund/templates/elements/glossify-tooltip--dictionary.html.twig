{#
/**
 * @file
 * Markup for inline tooltips.
 *
 * Available variables:
 * - word: the text where the tooltips applies to.
 * - tip: the tooltip text.
 * - tip_raw: the tooltip text in its raw format.
 * - langcode: the tooltip language code.
 *
 * @ingroup themeable
 */
#}
{# @todo We only support LTR languages as of now. #}
{% if entity.field_language.value != langcode -%}
  <span lang="{{ entity.field_language.value }}" dir="ltr" {% if tip %}title="{{ tip }}" class="glossify-tooltip-tip"{% endif %}>{{ word }}</span>
{%- else -%}
  {{ word }}
{%- endif %}
