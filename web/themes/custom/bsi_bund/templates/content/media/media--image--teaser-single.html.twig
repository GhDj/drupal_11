{#
/**
* @file
* Theme override for image media in teaser_single view mode (tiles).
*
* Wraps the image in a lightbox link with a maximize icon when
* the parent tile_item paragraph has a lightbox URL.
*/
#}
{% if lightbox_url %}
  {{ attach_library('core/drupal.ajax') }}
  {{ attach_library('core/drupal.dialog.ajax') }}

  <div{{ attributes }}>
    <a
      class="use-ajax bsi-card__chart"
      href="{{ lightbox_url }}"
      data-dialog-type="modal"
    >
      {{ content.field_media_image }}

      {% include '@bsi_bund/components/icon.twig' with {
        name: "maximize",
        decorative: true,
      } %}
    </a>
  </div>
{% else %}
  <div{{ attributes }}>
    {{ content.field_media_image }}
  </div>
{% endif %}
