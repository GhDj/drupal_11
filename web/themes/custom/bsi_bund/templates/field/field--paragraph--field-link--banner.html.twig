{#
/**
 * @file
 * Theme override for the banner paragraph link field.
 *
 * Extends field--link.html.twig and overrides the item block to render
 * the link as a secondary button.
 *
 * @see field--link.html.twig
 */
#}
{% extends '@bsi_bund/field/field--link.html.twig' %}

{% block item %}
  {% set modifiers = ['button', 'button--secondary'] %}
  {% set icon = 'chevron-right' %}
  {{ parent() }}
{% endblock %}
