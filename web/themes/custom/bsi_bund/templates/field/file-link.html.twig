{#
/**
 * @file
 * Theme override for a link to a file.
 */
#}

{% set title = file.mimeType == 'application/pdf' ? 'PDF' : link['#title'] %}

{% if file_size %}
  {% set title = title ~ ', ' ~ file_size ~ ' ' ~ 'download'|t %}
{% endif %}

{% include '@bsi_bund/elements/link.html.twig' with {
  'url': link['#url'],
  'title': title,
  'link_type': 'download',
  'icon': 'download',
  'icon_position': 'before',
  'extra_classes': [],
} only %}
