{#
/**
 * Download Teaser
 */
#}
{%
  set classes = [
    'bsi-block',
    'bsi-grid',
    'paragraph',
    'paragraph--type--' ~ paragraph.bundle|clean_class,
    view_mode ? 'paragraph--view-mode--' ~ view_mode|clean_class,
    not paragraph.isPublished() ? 'paragraph--unpublished'
  ]
%}
{% block paragraph %}
  <div{{ attributes.addClass(classes) }}>
    {% block content %}
      {{ content.field_section_title }}

      <div class="bsi-block__content bsi-block__content--indented">
        <div class="bsi-downloads">
          {{ content.field_media_items }}
        </div>
      </div>
    {% endblock %}
  </div>
{% endblock paragraph %}
