{#
/**
 * Facts & Figures item
 */
#}
{%
  set classes = [
    'bsi-facts',
    'paragraph',
    'paragraph--type--' ~ paragraph.bundle|clean_class,
    view_mode ? 'paragraph--view-mode--' ~ view_mode|clean_class,
    not paragraph.isPublished() ? 'paragraph--unpublished'
  ]
%}
{% block paragraph %}
  <div{{ attributes.addClass(classes) }}>
    {% block content %}
      <p class="bsi-facts__figure" data-bsi-facts-value>
        {{ content.field_section_title.0 }}
      </p>

      <div class="bsi-facts__text">{{ content.field_section_text.0 }}</div>
    {% endblock %}
  </div>
{% endblock paragraph %}
