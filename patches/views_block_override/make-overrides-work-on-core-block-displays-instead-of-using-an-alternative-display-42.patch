+++ b/views_block_override.install
@@ -0,0 +1,84 @@
+<?php
+
+/**
+ * @file
+ * Install file for views_blocks_override module.
+ */
+
+use Drupal\Component\Plugin\Exception\InvalidPluginDefinitionException;
+use Drupal\Component\Plugin\Exception\PluginNotFoundException;
+
+/**
+ * Implements hook_views_plugins_display_alter().
+ */
+function views_block_override_update_9001(array &$sandbox): void {
+
+  $logger = \Drupal::logger('update');
+
+  if (empty($sandbox['views'])) {
+    // Initialise the update batch.
+    try {
+      $storage = \Drupal::entityTypeManager()->getStorage('view');
+    }
+    catch (InvalidPluginDefinitionException | PluginNotFoundException $e) {
+      $logger->error($e->getMessage());
+      return;
+    }
+
+    $sandbox['views'] = $storage->getQuery()
+      ->accessCheck(FALSE)
+      ->execute();
+
+    if (empty($sandbox['views'])) {
+      $logger->notice(t('No views to update.'));
+      return;
+    }
+
+    $sandbox['views'] = array_keys($sandbox['views']);
+    $sandbox['current'] = 0;
+    $sandbox['total'] = count($sandbox['views']);
+    $sandbox['#finished'] = 0;
+  }
+
+  // Process each item found on by one.
+  $id = $sandbox['views'][$sandbox['current']] ?? 0;
+
+  // Load the config object for editing.
+  $config = \Drupal::service('config.factory')->getEditable('views.view.' . $id);
+
+  // Get full config data.
+  $data = $config->getRawData();
+
+  if (empty($data)) {
+    $logger->warning(t('View %id could not be loaded.', [
+      '%id' => $id,
+    ]));
+  }
+  else {
+    $display_ids = [];
+    foreach ($data['display'] as $display_id => $display_settings) {
+      if ($display_settings['display_plugin'] == 'views_block_override') {
+        $data['display'][$display_id]['display_plugin'] = 'block';
+        $display_ids[] = $display_id;
+      }
+    }
+
+    if (count($display_ids)) {
+      // Save the modified configuration.
+      $config->setData($data)->save();
+
+      $logger->notice(t('View %id updated displays: %display_ids.', [
+        '%id' => $id,
+        '%display_ids' => implode(', ', $display_ids),
+      ]));
+    }
+  }
+
+  $sandbox['current']++;
+  $sandbox['#finished'] = ($sandbox['current'] / $sandbox['total']);
+
+  if ($sandbox['#finished'] >= 1) {
+    $logger->notice(t('Rebuilding view cache'));
+    \Drupal::service('views.views_data')->clear();
+  }
+}
