+<?php
+
+namespace Drupal\views_block_override;
+
+use Drupal\Component\Plugin\Exception\PluginException;
+use Drupal\Core\Cache\CacheBackendInterface;
+use Drupal\Core\Extension\ModuleHandlerInterface;
+use Drupal\Core\Plugin\DefaultPluginManager;
+
+/**
+ * Provides a menu sort plugin manager.
+ */
+class ViewsBlockOverridePluginManager extends DefaultPluginManager implements ViewsBlockOverridePluginManagerInterface {
+
+  /**
+   * A cached lists of plugin instances.
+   *
+   * @var \Drupal\views_block_override\ViewsBlockOverridePluginInterface[]
+   */
+  protected array $pluginInstances = [];
+
+  /**
+   * Constructs a ViewsBlockOverridePluginManager object.
+   *
+   * @param \Traversable $namespaces
+   *   An object that implements \Traversable which contains the root paths
+   *   keyed by the corresponding namespace to look for plugin implementations.
+   * @param \Drupal\Core\Cache\CacheBackendInterface $cache_backend
+   *   Cache backend instance to use.
+   * @param \Drupal\Core\Extension\ModuleHandlerInterface $module_handler
+   *   The module handler to invoke the alter hook with.
+   */
+  public function __construct(\Traversable $namespaces, CacheBackendInterface $cache_backend, ModuleHandlerInterface $module_handler) {
+    parent::__construct(
+      'Plugin/views/display/block/override',
+      $namespaces,
+      $module_handler,
+      'Drupal\views_block_override\ViewsBlockOverridePluginInterface',
+      'Drupal\views_block_override\Annotation\ViewsBlockOverride'
+    );
+    $this->alterInfo('menu_sort_info');
+    $this->setCacheBackend($cache_backend, 'views_plugins_display_block_override_plugins');
+  }
+
+  /**
+   * {@inheritDoc}
+   */
+  public function getPluginOptions(): array {
+    $definitions = $this->getDefinitions() ?? [];
+
+    $options = array_map(
+      function (array $definition) {
+        return (string) $definition['label'];
+      },
+      $definitions
+    );
+
+    return $options ?: [];
+  }
+
+  /**
+   * {@inheritDoc}
+   */
+  public function getPlugins(): array {
+
+    if (empty($this->pluginInstances)) {
+      $definitions = $this->getDefinitions() ?? [];
+      foreach ($definitions as $plugin_id => $definition) {
+        try {
+          $this->pluginInstances[$plugin_id] = $this->createInstance($plugin_id, $definition);
+        }
+        catch (PluginException) {
+          // We do nothing, we just skip it.
+        }
+      }
+    }
+
+    return $this->pluginInstances;
+  }
+
+}
