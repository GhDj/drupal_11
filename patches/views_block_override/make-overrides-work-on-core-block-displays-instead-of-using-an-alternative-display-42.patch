+namespace Drupal\views_block_override\Annotation;
+
+use Drupal\Component\Annotation\Plugin;
+use Drupal\Core\Annotation\Translation;
+
+/**
+ * Defines a views block override plugin object.
+ *
+ * @Annotation
+ */
+class ViewsBlockOverride extends Plugin {
+
+  /**
+   * The plugin ID.
+   *
+   * @var string
+   */
+  public string $id;
+
+  /**
+   * The human-readable name of the plugin.
+   *
+   * @var string|\Drupal\Core\Annotation\Translation
+   *
+   * @ingroup plugin_translatable
+   */
+  public string|Translation $label;
+
+  /**
+   * The human-readable description of the plugin.
+   *
+   * @var string|\Drupal\Core\Annotation\Translation
+   *
+   * @ingroup plugin_translatable
+   */
+  public string|Translation $description;
+
+}
