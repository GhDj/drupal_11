+      $plugin_id,
+      $plugin_definition,
+      $container->get('entity_type.bundle.info'),
+      $container->get('entity_type.manager'),
+    );
+  }
+
+  /**
+   * {@inheritdoc}
+   */
+  public function blockSettings(array $settings, ViewExecutable $view): array {
+    $settings = parent::blockSettings($settings, $view);
+
+    // All contextual filters can be overridden.
+    $contextual_filters = $view->display_handler->getHandlers('argument');
+    foreach ($contextual_filters as $id => $contextual_filter) {
+      $settings['contextual_filter'][$id]['enabled'] = FALSE;
+      $settings['contextual_filter'][$id]['value'] = '';
+    }
+
+    return $settings;
+  }
+
+  /**
+   * {@inheritdoc}
+   */
+  public function blockForm(ViewsBlock $block, array &$form, FormStateInterface $form_state): array {
+    $form = parent::blockForm($block, $form, $form_state);
+
+    $block_configuration = $block->getConfiguration();
+
+    $items = $block->getViewExecutable()->display_handler->getHandlers('argument');
+
+    /** @var \Drupal\views\Plugin\views\HandlerBase $item */
+    foreach ($items as $id => $item) {
+
+      $configuration = $block_configuration['contextual_filter'][$id];
+
+      $item_form_element = [];
+
+      $item_form_element['enabled'] = [
+        '#type' => 'checkbox',
+        '#title' => $this->t('Override %plugin', ['%plugin' => $item->adminLabel()]),
+        '#default_value' => $configuration['enabled'],
+      ];
+
+      $item_form_element['value'] = [
+        '#type' => 'textfield',
+        '#title' => $this->t('Value for %label', ['%label' => $item->adminLabel()]),
+        '#title_display' => 'none',
+        '#default_value' => $configuration['value'],
+        '#states' => [
+          'visible' => [
+            [
+              ':input[name*="[override][contextual_filter][' . $id . '][enabled]"]' => ['checked' => TRUE],
+            ],
+          ],
+        ],
+      ];
+
+      // If a validator for entity type is set, create an autocomplete.
+      if (isset($item->options['validate']) &&
+        str_contains($item->options['validate']['type'], 'entity:')) {
+
+        $split = explode(':', $item->options['validate']['type']);
+        $entity_type = $split[1];
+
+        if (str_ends_with($entity_type, '_type')) {
+
+          $entity_type_id = substr($entity_type, 0, -5);
+
+          $bundles = $this->entityTypeBundleInfo->getBundleInfo($entity_type_id);
+          foreach ($bundles as &$bundle) {
+            $bundle = $bundle['label'];
+          }
+          unset($bundle);
+
+          if ($item->options['break_phrase']) {
+            $item_form_element['value']['#type'] = 'checkboxes';
+          }
+          else {
+            $item_form_element['value']['#type'] = 'radios';
+          }
+
+          $item_form_element['value']['#options'] = $bundles;
+          $item_form_element['value']['#default_value'] = $configuration['value'];
+        }
+        else {
+          $item_form_element['value']['#type'] = 'entity_autocomplete';
+          $item_form_element['value']['#target_type'] = $entity_type;
+
+          if ($configuration['value']) {
+            try {
+              $storage = $this->entityTypeManager->getStorage($entity_type);
+              $entity = $storage->load($configuration['value']);
+            }
+            catch (InvalidPluginDefinitionException | PluginNotFoundException) {
+              // Should never happen, but keep IDE happy.
+              $entity = NULL;
+            }
+
+            $item_form_element['value']['#default_value'] = $entity;
+          }
+          else {
+            $item_form_element['value']['#default_value'] = '';
+          }
+
+          if (isset($item->options['validate_options']['bundles'])) {
+            $item_form_element['value']['#selection_settings']['target_bundles'] = $item->options['validate_options']['bundles'];
+          }
+
+        }
+
+      }
+
+      $form['override']['contextual_filter'][$id] = $item_form_element;
+    }
+
+    return $form;
+  }
+
+  /**
+   * {@inheritdoc}
+   */
+  public function blockSubmit(ViewsBlock $block, $form, FormStateInterface $form_state): void {
+    parent::blockSubmit($block, $form, $form_state);
+
+    $overrides = $form_state->getValue(['override']);
+    $block_config = $block->getConfiguration();
+
+    // Get the submitted overrides.
+    $values = $overrides['contextual_filter'] ?? [];
+
+    foreach ($values as $id => $settings) {
+      if ($settings['enabled']) {
+        // Save overridden contextual_filter when control field is enabled.
+        $block_config['contextual_filter'][$id] = [
+          'enabled' => TRUE,
+          'value' => $settings['value'],
+        ];
+      }
+      else {
+        // Remove overridden contextual_filter when control field is not
+        // enabled.
+        unset($block_config['contextual_filter'][$id]);
+      }
+    }
+
+    $block->setConfiguration($block_config);
+  }
+
+  /**
+   * {@inheritdoc}
+   */
+  public function execute(): void {
+    parent::execute();
+
+    $block_config = $this->block->getConfiguration();
+    $view = $this->block->getViewExecutable();
+    $view_args = $view->args;
+
+    $index = 0;
+
+    foreach ($block_config['contextual_filter'] as $values) {
+      if ($values['enabled']) {
+
+        // Contextual filters can have multiple values.
+        if (is_array($values['value'])) {
+          $active_values = [];
+          foreach ($values['value'] as $value) {
+            if ($value) {
+              $active_values[] = $value;
+            }
+          }
+          $values['value'] = implode("+", $active_values);
+        }
+
+        $view_args[$index] = $values['value'];
+      }
+
+      $index++;
+    }
+
+    $view->setArguments($view_args);
+  }
+
+}
diff --git a/src/Plugin/views/display/block/override/ExposedSort.php b/src/Plugin/views/display/block/override/ExposedSort.php
new file mode 100644
index 0000000000000000000000000000000000000000..90483f48f07838f431d226088a6c76ed9eed960f
--- /dev/null
