@@ -0,0 +1,248 @@
+<?php
+
+namespace Drupal\views_block_override;
+
+use Drupal\Core\Block\BlockManagerInterface;
+use Drupal\Core\Entity\EntityTypeBundleInfo;
+use Drupal\Core\Entity\EntityTypeManagerInterface;
+use Drupal\Core\Form\FormStateInterface;
+use Drupal\Core\Plugin\ContainerFactoryPluginInterface;
+use Drupal\views\Plugin\Block\ViewsBlock;
+use Drupal\views\Plugin\views\display\Block;
+use Symfony\Component\DependencyInjection\ContainerInterface;
+
+/**
+ * An extended block display plugin.
+ *
+ * Allows to override views settings per block instance. It uses extra
+ * display override plugins to extend the settings of a core views block
+ * display.
+ *
+ * @ingroup views_block_override
+ *
+ * @see \Drupal\views\Plugin\block\ViewsBlock
+ * @see \Drupal\views\Plugin\Derivative\ViewsBlock
+ */
+class ViewsBlockDisplayOverride extends Block implements ContainerFactoryPluginInterface {
+
+  /**
+   * {@inheritdoc}
+   */
+  public function __construct(
+    array $configuration,
+    $plugin_id,
+    $plugin_definition,
+    EntityTypeManagerInterface $entity_type_manager,
+    BlockManagerInterface $block_manager,
+    protected EntityTypeBundleInfo $entityTypeBundleInfo,
+    protected ViewsBlockOverridePluginManagerInterface $overridePluginManager,
+  ) {
+    parent::__construct($configuration, $plugin_id, $plugin_definition, $entity_type_manager, $block_manager);
+  }
+
+  /**
+   * {@inheritdoc}
+   */
+  public static function create(ContainerInterface $container, array $configuration, $plugin_id, $plugin_definition) {
+    return new static(
+      $configuration,
+      $plugin_id,
+      $plugin_definition,
+      $container->get('entity_type.manager'),
+      $container->get('plugin.manager.block'),
+      $container->get('entity_type.bundle.info'),
+      $container->get('views_block_override.manager')
+    );
+  }
+
+  /**
+   * {@inheritdoc}
+   */
+  protected function defineOptions(): array {
+    $options = parent::defineOptions();
+
+    $plugins = $this->overridePluginManager->getPlugins();
+
+    foreach ($plugins as $plugin) {
+      $plugin->defineOptions($options);
+    }
+
+    return $options;
+  }
+
+  /**
+   * {@inheritdoc}
+   */
+  public function blockSettings(array $settings): array {
+    $settings = parent::blockSettings($settings);
+
+    $allow_settings = array_filter($this->getOption('allow'));
+
+    $plugins = $this->overridePluginManager->getPlugins();
+
+    foreach ($plugins as $plugin_id => $plugin) {
+      if (empty($allow_settings[$plugin_id])) {
+        continue;
+      }
+      $settings = $plugin->blockSettings($settings, $this->view);
+    }
+
+    return $settings;
+  }
+
+  /**
+   * {@inheritdoc}
+   */
+  public function execute() {
+
+    $allow_settings = array_filter($this->getOption('allow'));
+
+    $plugins = $this->overridePluginManager->getPlugins();
+
+    foreach ($plugins as $plugin_id => $plugin) {
+      if (empty($allow_settings[$plugin_id])) {
+        continue;
+      }
+
+      $plugin->execute();
+    }
+
+    return parent::execute();
+  }
+
+  /**
+   * {@inheritdoc}
+   */
+  public function optionsSummary(&$categories, &$options): void {
+    parent::optionsSummary($categories, $options);
+
+    // Override what core did for 'allow'.
+    $filtered_allow = array_filter($this->getOption('allow'));
+    $allowed = [];
+
+    $plugins = $this->overridePluginManager->getPlugins();
+    foreach ($plugins as $plugin_id => $plugin) {
+      if (isset($filtered_allow[$plugin_id])) {
+        $plugin_summary = $plugin->optionsSummary($categories, $options);
+        if (!empty($plugin_summary)) {
+          $allowed[] = implode(', ', $plugin_summary);
+        }
+      }
+    }
+
+    $options['allow'] = [
+      'category' => 'block',
+      'title' => $this->t('Allow settings'),
+      'value' => empty($allowed) ? $this->t('None') : implode(', ', $allowed),
+    ];
+  }
+
+  /**
+   * {@inheritdoc}
+   */
+  public function buildOptionsForm(&$form, FormStateInterface $form_state): void {
+    parent::buildOptionsForm($form, $form_state);
+
+    // Override what core did for 'allow'.
+    if ($form_state->get('section') == 'allow') {
+      $form['allow']['#options'] = $this->overridePluginManager->getPluginOptions();
+    }
+
+    // Let the plugins build their form options.
+    $plugins = $this->overridePluginManager->getPlugins();
+    foreach ($plugins as $plugin) {
+      $plugin->buildOptionsForm($form, $form_state);
+    }
+  }
+
+  /**
+   * {@inheritdoc}
+   */
+  public function submitOptionsForm(&$form, FormStateInterface $form_state): void {
+    parent::submitOptionsForm($form, $form_state);
+
+    // Let the plugins handle their form submition.
+    $plugins = $this->overridePluginManager->getPlugins();
+    foreach ($plugins as $plugin) {
+      $plugin->submitOptionsForm($form, $form_state);
+    }
+  }
+
+  /**
+   * {@inheritdoc}
+   */
+  public function blockForm(ViewsBlock $block, array &$form, FormStateInterface $form_state): array {
+    $form = parent::blockForm($block, $form, $form_state);
+
+    $allow_settings = array_filter($this->getOption('allow'));
+
+    $plugins = $this->overridePluginManager->getPlugins();
+    foreach ($plugins as $plugin_id => $plugin) {
+      if (empty($allow_settings[$plugin_id])) {
+        continue;
+      }
+
+      $form = $plugin->blockForm($block, $form, $form_state);
+    }
+
+    return $form;
+  }
+
+  /**
+   * {@inheritdoc}
+   */
+  public function blockValidate(ViewsBlock $block, array $form, FormStateInterface $form_state): void {
+    parent::blockValidate($block, $form, $form_state);
+
+    $allow_settings = array_filter($this->getOption('allow'));
+
+    $plugins = $this->overridePluginManager->getPlugins();
+    foreach ($plugins as $plugin_id => $plugin) {
+      if (empty($allow_settings[$plugin_id])) {
+        continue;
+      }
+
+      $plugin->blockValidate($block, $form, $form_state);
+    }
+  }
+
+  /**
+   * {@inheritdoc}
+   */
+  public function blockSubmit(ViewsBlock $block, $form, FormStateInterface $form_state): void {
+    parent::blockSubmit($block, $form, $form_state);
+
+    $overrides = $form_state->getValue(['override']);
+
+    $plugins = $this->overridePluginManager->getPlugins();
+
+    foreach ($plugins as $plugin_id => $plugin) {
+
+      if (empty($overrides[$plugin_id])) {
+        continue;
+      }
+
+      $plugin->blockSubmit($block, $form, $form_state);
+    }
+  }
+
+  /**
+   * {@inheritdoc}
+   */
+  public function preBlockBuild(ViewsBlock $block): void {
+    parent::preBlockBuild($block);
+
+    $allow_settings = array_filter($this->getOption('allow'));
+
+    $plugins = $this->overridePluginManager->getPlugins();
+    foreach ($plugins as $plugin_id => $plugin) {
+      if (empty($allow_settings[$plugin_id])) {
+        continue;
+      }
+
+      $plugin->preBlockBuild($block);
+    }
+
+  }
+
+}
