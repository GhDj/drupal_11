@@ -0,0 +1,167 @@
+<?php
+
+namespace Drupal\views_block_override\Plugin\views\display\block\override;
+
+use Drupal\Core\Entity\EntityTypeBundleInfo;
+use Drupal\Core\Entity\EntityTypeManagerInterface;
+use Drupal\Core\Form\FormStateInterface;
+use Drupal\views\Plugin\Block\ViewsBlock;
+use Drupal\views\ViewExecutable;
+use Drupal\views_block_override\ViewsBlockOverridePluginBase;
+use Symfony\Component\DependencyInjection\ContainerInterface;
+
+/**
+ * Provides a exposed sort block override.
+ *
+ * @ViewsBlockOverride(
+ *   id = "exposed_sort",
+ *   label = @Translation("Exposed sort"),
+ *   description = @Translation("Override exposed sort settings."),
+ * )
+ */
+class ExposedSort extends ViewsBlockOverridePluginBase {
+
+  /**
+   * {@inheritdoc}
+   */
+  public function __construct(
+    array $configuration,
+    $plugin_id,
+    $plugin_definition,
+    protected EntityTypeBundleInfo $entityTypeBundleInfo,
+    protected EntityTypeManagerInterface $entityTypeManager,
+  ) {
+    parent::__construct($configuration, $plugin_id, $plugin_definition);
+  }
+
+  /**
+   * {@inheritdoc}
+   */
+  public static function create(ContainerInterface $container, array $configuration, $plugin_id, $plugin_definition): static {
+    return new static(
+      $configuration,
+      $plugin_id,
+      $plugin_definition,
+      $container->get('entity_type.bundle.info'),
+      $container->get('entity_type.manager'),
+    );
+  }
+
+  /**
+   * {@inheritdoc}
+   */
+  public function blockSettings(array $settings, ViewExecutable $view): array {
+    $settings = parent::blockSettings($settings, $view);
+
+    $options = $this->getSortOptions($view);
+
+    $settings['exposed_sort']['sort_by'] = array_key_first($options) ?? 'title';
+    $settings['exposed_sort']['sort_order'] = 'DESC';
+
+    return $settings;
+  }
+
+  /**
+   * {@inheritdoc}
+   */
+  public function blockForm(ViewsBlock $block, array &$form, FormStateInterface $form_state): array {
+    $form = parent::blockForm($block, $form, $form_state);
+
+    $block_configuration = $block->getConfiguration();
+
+    $form['override']['exposed_sort']['sort_by'] = [
+      '#type' => 'select',
+      '#title' => $this->t('Order'),
+      '#options' => $this->getSortOptions($block->getViewExecutable()),
+      '#default_value' => $block_configuration['exposed_sort']['sort_by'],
+    ];
+    $form['override']['exposed_sort']['sort_order'] = [
+      '#type' => 'select',
+      '#title' => $this->t('Sort'),
+      '#options' => [
+        'ASC' => $this->t('Ascending'),
+        'DESC' => $this->t('Descending'),
+      ],
+      '#default_value' => $block_configuration['exposed_sort']['sort_order'],
+    ];
+
+    return $form;
+  }
+
+  /**
+   * {@inheritdoc}
+   */
+  public function blockSubmit(ViewsBlock $block, $form, FormStateInterface $form_state): void {
+    parent::blockSubmit($block, $form, $form_state);
+
+    $overrides = $form_state->getValue(['override']);
+    $block_config = $block->getConfiguration();
+
+    $block_config['exposed_sort'] = $overrides['exposed_sort'] ?? [];
+
+    if (empty($block_config['exposed_sort'])) {
+      // Remove override when there is no value.
+      unset($block_config['exposed_sort']);
+    }
+
+    $block->setConfiguration($block_config);
+  }
+
+  /**
+   * {@inheritdoc}
+   */
+  public function preBlockBuild(ViewsBlock $block): void {
+    parent::preBlockBuild($block);
+
+    $block_config = $block->getConfiguration();
+
+    if (!empty($block_config['exposed_sort'])) {
+
+      // Get original sorts.
+      $sorts = $block->getViewExecutable()->display_handler->getOption('sorts');
+
+      // Get the selected exposed sort and set it as the only sort option.
+      if (!empty($block_config['exposed_sort']['sort_by'])) {
+
+        // In some situations, the exposed sort is not passed as a nested
+        // [value].
+        $sort_by = $block_config['exposed_sort']['sort_by']['value'] ?? $block_config['exposed_sort']['sort_by'];
+        $sort_order = $block_config['exposed_sort']['sort_order']['value'] ?? $block_config['exposed_sort']['sort_order'];
+
+        $exposed_sort = $sorts[$sort_by];
+        $exposed_sort['order'] = $sort_order;
+
+        $block->getViewExecutable()->display_handler->setOption('sorts', [$exposed_sort]);
+      }
+    }
+
+  }
+
+  /**
+   * Get the sort handlers as an options list.
+   *
+   * @param \Drupal\views\ViewExecutable $view
+   *   The view to get the sorting handlers from.
+   *
+   * @return array
+   *   A list of sort handlers, keyed by the field.
+   */
+  protected function getSortOptions(ViewExecutable $view): array {
+    $sort_handlers = $view->getHandlers('sort');
+
+    $options = [];
+
+    foreach ($sort_handlers as $field => $handler) {
+      // Use exposed label when available, or use machine name as backup.
+      if (!empty($handler['expose']['label'])) {
+        $options[$field] = $handler['expose']['label'];
+      }
+      else {
+        $options[$field] = $handler['field'];
+      }
+    }
+
+    return $options;
+  }
+
+}
