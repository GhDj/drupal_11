+<?php
+
+namespace Drupal\views_block_override;
+
+use Drupal\Core\Form\FormStateInterface;
+use Drupal\Core\StringTranslation\TranslatableMarkup;
+use Drupal\views\Plugin\Block\ViewsBlock;
+use Drupal\views\ViewExecutable;
+
+/**
+ * Provides a views block override plugin interface.
+ *
+ * @see \Drupal\views_block_override\Annotation\ViewsBlockOverride
+ * @see plugin_api
+ */
+interface ViewsBlockOverridePluginInterface {
+
+  /**
+   * Get the label of this plugin.
+   *
+   * @return \Drupal\Core\StringTranslation\TranslatableMarkup|string
+   *   The human readable name of this plugin.
+   */
+  public function getLabel(): TranslatableMarkup|string;
+
+  /**
+   * Get the description of this plugin.
+   *
+   * @return \Drupal\Core\StringTranslation\TranslatableMarkup|string
+   *   The description of this plugin.
+   */
+  public function getDescription(): TranslatableMarkup|string;
+
+  /**
+   * Information about options for all kinds of purposes will be held here.
+   *
+   * @param array $options
+   *   The options array to modify or to add items to.
+   *
+   * @see \Drupal\views\Plugin\views\display\Block::defineOptions()
+   * @see \Drupal\views_block_override\ViewsBlockDisplayOverride::defineOptions()
+   */
+  public function defineOptions(array &$options): void;
+
+  /**
+   * Returns plugin-specific settings for the block.
+   *
+   * This method is only called when this plugin is allowed in the block
+   * override settings of the view configuration.
+   *
+   * @param array $settings
+   *   The complete settings of the block.
+   * @param \Drupal\views\ViewExecutable $view
+   *   The view executable being manipulated.
+   *
+   * @return array
+   *   An array of block-specific settings to override the defaults provided in
+   *   \Drupal\views\Plugin\Block\ViewsBlock::defaultConfiguration().
+   *
+   * @see \Drupal\views\Plugin\views\display\Block::blockSettings()
+   * @see \Drupal\views_block_override\ViewsBlockDisplayOverride::blockSettings()
+   */
+  public function blockSettings(array $settings, ViewExecutable $view): array;
+
+  /**
+   * Allow for maniulating the view right before execution.
+   *
+   * This method is only called when this plugin is allowed in the block
+   * override settings of the view configuration.
+   *
+   * @see \Drupal\views\Plugin\views\display\Block::execute()
+   * @see \Drupal\views_block_override\ViewsBlockDisplayOverride::execute()
+   */
+  public function execute();
+
+  /**
+   * Provide the summary for block options in the views UI.
+   *
+   * @return array
+   *   A list of strings summarizing this plugins settings.
+   *
+   * @see \Drupal\views\Plugin\views\display\Block::optionsSummary()
+   * @see \Drupal\views_block_override\ViewsBlockDisplayOverride::optionsSummary()
+   */
+  public function optionsSummary(&$categories, &$options): array;
+
+  /**
+   * Provide the default form for setting options.
+   *
+   * @see \Drupal\views\Plugin\views\display\Block::buildOptionsForm()
+   * @see \Drupal\views_block_override\ViewsBlockDisplayOverride::buildOptionsForm()
+   */
+  public function buildOptionsForm(&$form, FormStateInterface $form_state): void;
+
+  /**
+   * Perform any necessary changes to the options form values prior to storage.
+   *
+   * There is no need for this function to actually store the data.
+   *
+   * @see \Drupal\views\Plugin\views\display\Block::submitOptionsForm()
+   * @see \Drupal\views_block_override\ViewsBlockDisplayOverride::submitOptionsForm()
+   */
+  public function submitOptionsForm(&$form, FormStateInterface $form_state): void;
+
+  /**
+   * Adds the configuration form elements specific to this views block plugin.
+   *
+   * This method is only called when this plugin is allowed in the block
+   * override settings of the view configuration.
+   *
+   * @param \Drupal\views\Plugin\Block\ViewsBlock $block
+   *   The ViewsBlock plugin.
+   * @param array $form
+   *   The form definition array for the block configuration form.
+   * @param \Drupal\Core\Form\FormStateInterface $form_state
+   *   The current state of the form.
+   *
+   * @return array
+   *   The renderable form array representing the entire configuration form.
+   *
+   * @see \Drupal\views\Plugin\views\display\Block::blockForm()
+   * @see \Drupal\views_block_override\ViewsBlockDisplayOverride::blockForm()
+   */
+  public function blockForm(ViewsBlock $block, array &$form, FormStateInterface $form_state): array;
+
+  /**
+   * Handles form validation for the views block configuration form.
+   *
+   * This method is only called when this plugin is allowed in the block
+   * override settings of the view configuration.
+   *
+   * @param \Drupal\views\Plugin\Block\ViewsBlock $block
+   *   The ViewsBlock plugin.
+   * @param array $form
+   *   The form definition array for the block configuration form.
+   * @param \Drupal\Core\Form\FormStateInterface $form_state
+   *   The current state of the form.
+   *
+   * @see \Drupal\views\Plugin\views\display\Block::blockValidate()
+   * @see \Drupal\views_block_override\ViewsBlockDisplayOverride::blockValidate()
+   */
+  public function blockValidate(ViewsBlock $block, array $form, FormStateInterface $form_state);
+
+  /**
+   * Handles form submission for the views block configuration form.
+   *
+   * This method is only called when this plugin is allowed in the block
+   * override settings of the view configuration.
+   *
+   * @param \Drupal\views\Plugin\Block\ViewsBlock $block
+   *   The ViewsBlock plugin.
+   * @param array $form
+   *   The form definition array for the full block configuration form.
+   * @param \Drupal\Core\Form\FormStateInterface $form_state
+   *   The current state of the form.
+   *
+   * @see \Drupal\views\Plugin\views\display\Block::blockSubmit()
+   * @see \Drupal\views_block_override\ViewsBlockDisplayOverride::blockSubmit()
+   */
+  public function blockSubmit(ViewsBlock $block, array $form, FormStateInterface $form_state);
+
+  /**
+   * Allows to change the display settings right before executing the block.
+   *
+   * This method is only called when this plugin is allowed in the block
+   * override settings of the view configuration.
+   *
+   * If you override this method, and want to manipulate the view or block in
+   * the execute call, you should call the parent base implentation. It stores
+   * the block in the plugin instance.
+   *
+   * @param \Drupal\views\Plugin\Block\ViewsBlock $block
+   *   The block plugin for views displays.
+   *
+   * @see \Drupal\views\Plugin\views\display\Block::preBlockBuild()
+   * @see \Drupal\views_block_override\ViewsBlockOverridePluginBase::preBlockBuild()
+   * @see \Drupal\views_block_override\ViewsBlockDisplayOverride::preBlockBuild()
+   */
+  public function preBlockBuild(ViewsBlock $block): void;
+
+}
