+<?php
+
+namespace Drupal\views_block_override;
+
+use Drupal\Core\Form\FormStateInterface;
+use Drupal\Core\Plugin\ContainerFactoryPluginInterface;
+use Drupal\Core\Plugin\PluginBase;
+use Drupal\Core\StringTranslation\TranslatableMarkup;
+use Drupal\views\Plugin\Block\ViewsBlock;
+use Drupal\views\ViewExecutable;
+use Symfony\Component\DependencyInjection\ContainerInterface;
+
+/**
+ * Base class for views block override plugins.
+ *
+ * @ingroup plugin_api
+ */
+abstract class ViewsBlockOverridePluginBase extends PluginBase implements ViewsBlockOverridePluginInterface, ContainerFactoryPluginInterface {
+
+  /**
+   * The block being overridden.
+   *
+   * @var \Drupal\views\Plugin\Block\ViewsBlock
+   */
+  protected ViewsBlock $block;
+
+  /**
+   * {@inheritdoc}
+   */
+  public static function create(ContainerInterface $container, array $configuration, $plugin_id, $plugin_definition): static {
+    return new static(
+      $configuration,
+      $plugin_id,
+      $plugin_definition
+    );
+  }
+
+  /**
+   * Get the name of this plugin.
+   *
+   * @return \Drupal\Core\StringTranslation\TranslatableMarkup|string
+   *   The human readable name of this plugin.
+   */
+  public function getLabel(): TranslatableMarkup|string {
+    return $this->getPluginDefinition()['label'];
+  }
+
+  /**
+   * Get the description of this plugin.
+   *
+   * @return \Drupal\Core\StringTranslation\TranslatableMarkup|string
+   *   The description of this plugin.
+   */
+  public function getDescription(): TranslatableMarkup|string {
+    return $this->getPluginDefinition()['description'];
+  }
+
+  /**
+   * {@inheritdoc}
+   */
+  public function defineOptions(array &$options): void {
+    if (empty($options['allow']['contains'][$this->getPluginId()])) {
+      $options['allow']['contains'][$this->getPluginId()] = ['default' => FALSE];
+    }
+  }
+
+  /**
+   * {@inheritdoc}
+   */
+  public function blockSettings(array $settings, ViewExecutable $view): array {
+    return $settings;
+  }
+
+  /**
+   * {@inheritdoc}
+   */
+  public function execute(): void {}
+
+  /**
+   * {@inheritdoc}
+   */
+  public function optionsSummary(&$categories, &$options): array {
+    return [
+      $this->getLabel(),
+    ];
+  }
+
+  /**
+   * {@inheritdoc}
+   */
+  public function buildOptionsForm(&$form, FormStateInterface $form_state): void {}
+
+  /**
+   * {@inheritdoc}
+   */
+  public function submitOptionsForm(&$form, FormStateInterface $form_state): void {}
+
+  /**
+   * {@inheritdoc}
+   */
+  public function blockForm(ViewsBlock $block, array &$form, FormStateInterface $form_state): array {
+    return $form;
+  }
+
+  /**
+   * {@inheritdoc}
+   */
+  public function blockValidate(ViewsBlock $block, array $form, FormStateInterface $form_state): void {}
+
+  /**
+   * {@inheritdoc}
+   */
+  public function blockSubmit(ViewsBlock $block, array $form, FormStateInterface $form_state): void {}
+
+  /**
+   * {@inheritdoc}
+   */
+  public function preBlockBuild(ViewsBlock $block): void {
+    // Store the block, so other functions can use it.
+    $this->block = $block;
+  }
+
+}
