+<?php
+
+namespace Drupal\views_block_override\Plugin\views\display\block\override;
+
+use Drupal\Core\Form\FormStateInterface;
+use Drupal\views\Plugin\Block\ViewsBlock;
+use Drupal\views\ViewExecutable;
+use Drupal\views_block_override\ViewsBlockOverridePluginBase;
+
+/**
+ * Provides a pager id block override.
+ *
+ * @ViewsBlockOverride(
+ *   id = "pager_id",
+ *   label = @Translation("Pager ID"),
+ *   description = @Translation("Override the pager ID."),
+ * )
+ */
+class PagerId extends ViewsBlockOverridePluginBase {
+
+  /**
+   * {@inheritdoc}
+   */
+  public function blockSettings(array $settings, ViewExecutable $view): array {
+    $settings = parent::blockSettings($settings, $view);
+
+    $pager = $view->display_handler->getOption('pager');
+
+    $settings['pager_id']['enabled'] = FALSE;
+    $settings['pager_id']['value'] = $pager['options']['id'] ?? 0;
+
+    return $settings;
+  }
+
+  /**
+   * {@inheritdoc}
+   */
+  public function blockForm(ViewsBlock $block, array &$form, FormStateInterface $form_state): array {
+    $form = parent::blockForm($block, $form, $form_state);
+
+    $block_configuration = $block->getConfiguration();
+
+    $form['override']['pager_id']['enabled'] = [
+      '#type' => 'checkbox',
+      '#title' => $this->t('Override pager ID'),
+      '#description' => $this->t("Unless you're experiencing problems with pagers related to this view, you should leave this disabled."),
+      '#default_value' => $block_configuration['pager_id']['enabled'],
+    ];
+
+    $form['override']['pager_id']['value'] = [
+      '#type' => 'number',
+      '#title' => $this->t('Pager ID'),
+      '#min' => 0,
+      '#default_value' => $block_configuration['pager_id']['value'],
+      '#description' => $this->t("Unless you're experiencing problems with pagers related to this view, you should leave this at it's default value. If using multiple pagers on one page you may need to set this number to a higher value so as not to conflict within the ?page= array. Large values will add a lot of commas to your URLs, so avoid if possible."),
+      '#states' => [
+        'visible' => [
+          [
+            ':input[name*="[override][pager_id][enabled]"]' => ['checked' => TRUE],
+          ],
+        ],
+      ],
+    ];
+
+    return $form;
+  }
+
+  /**
+   * {@inheritdoc}
+   */
+  public function blockSubmit(ViewsBlock $block, $form, FormStateInterface $form_state): void {
+    parent::blockSubmit($block, $form, $form_state);
+
+    $overrides = $form_state->getValue(['override']);
+    $block_config = $block->getConfiguration();
+
+    // Get the submitted overrides.
+    $values = $overrides['pager_id'] ?? [];
+
+    if (!empty($values['enabled'])) {
+      $block_config['pager_id'] = $values;
+    }
+    else {
+      unset($block_config['pager_id']);
+    }
+
+    $block->setConfiguration($block_config);
+  }
+
+  /**
+   * {@inheritdoc}
+   */
+  public function preBlockBuild(ViewsBlock $block): void {
+    parent::preBlockBuild($block);
+
+    $block_config = $block->getConfiguration();
+
+    if (!empty($block_config['pager_id']['enabled']) && !empty($block_config['pager_id']['value'])) {
+      $pager = $block->getViewExecutable()->display_handler->getOption('pager');
+      $pager['options']['id'] = $block_config['pager_id']['value'];
+      $block->getViewExecutable()->display_handler->setOption('pager', $pager);
+    }
+  }
+
+}
