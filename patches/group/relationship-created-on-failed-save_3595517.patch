     $this->assertTrue($this->createFormEnhancer->isFormEnhanced($form));
   }

+  /**
+   * Tests that the enhancer survives a serialization round trip.
+   *
+   * The enhancer attaches itself to enhanced forms as a validate and submit
+   * callable, so it ends up in the form cache whenever such a form is cached,
+   * for example when it is rebuilt after a failed entity save.
+   */
+  public function testSerialization(): void {
+    $enhancer = unserialize(serialize($this->createFormEnhancer));
+    $this->assertInstanceOf(CreateFormEnhancerInterface::class, $enhancer);
+  }
+
 }
