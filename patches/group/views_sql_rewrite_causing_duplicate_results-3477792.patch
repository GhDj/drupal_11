@@ -0,0 +1,68 @@
+<?php
+
+declare(strict_types=1);
+
+namespace Drupal\Tests\group\Kernel\Views;
+
+use Drupal\Tests\group\Traits\NodeTypeCreationTrait;
+use Drupal\group\Entity\Storage\GroupRelationshipTypeStorageInterface;
+use Drupal\views\Views;
+use PHPUnit\Framework\Attributes\RunTestsInSeparateProcesses;
+
+/**
+ * Tests entity query access alterations in Views.
+ *
+ * @group group
+ */
+#[RunTestsInSeparateProcesses]
+class EntityQueryAlterTest extends GroupViewsKernelTestBase {
+
+  use NodeTypeCreationTrait;
+
+  /**
+   * {@inheritdoc}
+   */
+  protected static $modules = ['group_test_plugin', 'node'];
+
+  /**
+   * Views used by this test.
+   *
+   * @var array
+   */
+  public static $testViews = ['test_group_entity_access_duplicates'];
+
+  /**
+   * {@inheritdoc}
+   */
+  protected function setUp($import_test_views = TRUE): void {
+    parent::setUp($import_test_views);
+    $this->installEntitySchema('node');
+    $this->createNodeType(['type' => 'page']);
+
+    $storage = $this->entityTypeManager->getStorage('group_relationship_type');
+    assert($storage instanceof GroupRelationshipTypeStorageInterface);
+    $storage->createFromPlugin($this->groupType, 'node_relation:page')->save();
+  }
+
+  /**
+   * Tests that access joins do not duplicate entities related to many groups.
+   */
+  public function testEntityInMultipleGroupsIsNotDuplicated(): void {
+    $node = $this->entityTypeManager->getStorage('node')->create([
+      'type' => 'page',
+      'title' => $this->randomString(),
+    ]);
+    $node->save();
+
+    $this->createGroup()->addRelationship($node, 'node_relation:page');
+    $this->createGroup()->addRelationship($node, 'node_relation:page');
+
+    $view = Views::getView('test_group_entity_access_duplicates');
+    $view->setDisplay();
+    $view->execute();
+
+    $this->assertCount(1, $view->result);
+    $this->assertSame(1, (int) $view->total_rows);
+  }
+
+}
