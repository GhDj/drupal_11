@@ -0,0 +1,146 @@
+<?php
+
+namespace Drupal\Tests\paragraphs\Functional\WidgetStable;
+
+use Drupal\Tests\paragraphs\Traits\ParagraphsCoreVersionUiTestTrait;
+use Drupal\Tests\paragraphs\Traits\ParagraphsLastEntityQueryTrait;
+use Drupal\language\Entity\ConfigurableLanguage;
+use PHPUnit\Framework\Attributes\Group;
+use PHPUnit\Framework\Attributes\RunTestsInSeparateProcesses;
+
+/**
+ * Tests paragraphs validation with Content Moderation and translations.
+ *
+ * @group paragraphs
+ *
+ * @see https://www.drupal.org/project/paragraphs/issues/3582767
+ * @see https://www.drupal.org/project/entity_reference_revisions/issues/3150084
+ */
+#[RunTestsInSeparateProcesses]
+#[Group('paragraphs')]
+class ParagraphsContentModerationValidationTest extends ParagraphsTestBase {
+
+  use ParagraphsLastEntityQueryTrait, ParagraphsCoreVersionUiTestTrait;
+
+  /**
+   * Modules to enable.
+   *
+   * @var array
+   */
+  protected static $modules = [
+    'node',
+    'paragraphs_test',
+    'paragraphs',
+    'field',
+    'field_ui',
+    'block',
+    'link',
+    'content_moderation',
+    'content_translation',
+  ];
+
+  /**
+   * {@inheritdoc}
+   */
+  protected function setUp(): void {
+    parent::setUp();
+    $this->placeDefaultBlocks();
+
+    $this->addParagraphedContentType('paragraphed_test');
+
+    ConfigurableLanguage::createFromLangcode('de')->save();
+
+    $this->createEditorialWorkflow('paragraphed_test');
+
+    $this->loginAsAdmin([
+      'access administration pages',
+      'view any unpublished content',
+      'view all revisions',
+      'view latest version',
+      'use ' . $this->workflow->id() . ' transition create_new_draft',
+      'use ' . $this->workflow->id() . ' transition publish',
+      'administer nodes',
+      'bypass node access',
+      'administer content translation',
+      'translate any entity',
+      'create content translations',
+      'administer languages',
+      'administer content types',
+      'administer node form display',
+      'edit any paragraphed_test content',
+      'create paragraphed_test content',
+    ]);
+
+    // Add a paragraph type with a translatable and a non-translatable field.
+    $this->addParagraphsType('text');
+    static::fieldUIAddNewField('admin/structure/paragraphs_type/text', 'text', 'Text', 'text_long', [], []);
+    static::fieldUIAddNewField('admin/structure/paragraphs_type/text', 'untranslatable', 'Untranslatable', 'string', [], []);
+
+    // Enable translation on the paragraph type. Do NOT hide untranslatable
+    // fields so that the EntityUntranslatableFieldsConstraintValidator
+    // inspects them during validation.
+    $edit = [
+      'entity_types[paragraph]' => TRUE,
+      'entity_types[node]' => TRUE,
+      'settings[node][paragraphed_test][translatable]' => TRUE,
+      'settings[node][paragraphed_test][fields][field_paragraphs]' => FALSE,
+      'settings[node][paragraphed_test][settings][language][language_alterable]' => TRUE,
+      'settings[paragraph][text][translatable]' => TRUE,
+      'settings[paragraph][text][settings][content_translation][untranslatable_fields_hide]' => FALSE,
+      'settings[paragraph][text][fields][field_text]' => TRUE,
+      'settings[paragraph][text][fields][field_untranslatable]' => FALSE,
+    ];
+    $this->drupalGet('admin/config/regional/content-language');
+    $this->submitForm($edit, 'Save configuration');
+  }
+
+  /**
+   * Tests saving a node does not trigger an untranslatable fields error.
+   *
+   * Content Moderation sets isDefaultRevision=FALSE on all paragraph entities
+   * during form prepare. The fix in ParagraphsWidget::massageFormValues()
+   * corrects this flag before validation fires.
+   */
+  public function testSaveDoesNotTriggerUntranslatableFieldsError() {
+    $session = $this->getSession();
+    $page = $session->getPage();
+    $assert_session = $this->assertSession();
+
+    // Create a published node with a paragraph.
+    $this->drupalGet('node/add/paragraphed_test');
+    $page->fillField('title[0][value]', 'Test node');
+    $page->pressButton('Add text');
+    $page->fillField('field_paragraphs[0][subform][field_text][0][value]', 'Translatable text');
+    $page->fillField('field_paragraphs[0][subform][field_untranslatable][0][value]', 'Untranslatable text');
+    $page->selectFieldOption('moderation_state[0][state]', 'published');
+    $page->pressButton('Save');
+    $assert_session->pageTextContains('paragraphed_test Test node has been created.');
+
+    $node = $this->getLastEntityOfType('node', TRUE);
+
+    // Edit the existing node and save as published. Without the fix, this
+    // triggers "Non-translatable fields can only be changed when updating the
+    // current revision." because Content Moderation sets isDefaultRevision
+    // to FALSE during form prepare and the paragraphs still carry that flag
+    // when validation fires.
+    $this->drupalGet("node/{$node->id()}/edit");
+    $page->fillField('field_paragraphs[0][subform][field_text][0][value]', 'Updated text');
+    $page->fillField('field_paragraphs[0][subform][field_untranslatable][0][value]', 'Changed untranslatable');
+    $page->selectFieldOption('moderation_state[0][state]', 'published');
+    $page->pressButton('Save');
+    $assert_session->pageTextNotContains('Non-translatable fields can only be changed when updating the current revision.');
+    $assert_session->pageTextContains('paragraphed_test Test node has been updated.');
+    $assert_session->pageTextContains('Changed untranslatable');
+
+    // Edit the node, change the non-translatable field and save as draft.
+    $this->drupalGet("node/{$node->id()}/edit");
+    $page->fillField('field_paragraphs[0][subform][field_text][0][value]', 'Draft text');
+    $page->fillField('field_paragraphs[0][subform][field_untranslatable][0][value]', 'Draft untranslatable');
+    $page->selectFieldOption('moderation_state[0][state]', 'draft');
+    $page->pressButton('Save');
+    $assert_session->pageTextNotContains('Non-translatable fields can only be changed when updating the current revision.');
+    $assert_session->pageTextContains('paragraphed_test Test node has been updated.');
+    $assert_session->pageTextContains('Draft untranslatable');
+  }
+
+}
