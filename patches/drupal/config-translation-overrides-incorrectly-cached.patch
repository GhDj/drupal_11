diff --git a/core/modules/field/tests/src/Kernel/FieldConfigLanguageOverrideTest.php b/core/modules/field/tests/src/Kernel/FieldConfigLanguageOverrideTest.php
new file mode 100644
index 0000000000000000000000000000000000000000..2d5d6b536bdd8d87e0a895bedc2ddce2f40550bc
--- /dev/null
+++ b/core/modules/field/tests/src/Kernel/FieldConfigLanguageOverrideTest.php
@@ -0,0 +1,157 @@
+<?php
+
+declare(strict_types=1);
+
+namespace Drupal\Tests\field\Kernel;
+
+use Drupal\Core\Entity\EntityFieldManagerInterface;
+use Drupal\entity_test\EntityTestHelper;
+use Drupal\field\Entity\FieldConfig;
+use Drupal\field\Entity\FieldStorageConfig;
+use Drupal\language\ConfigurableLanguageManagerInterface;
+use Drupal\language\Entity\ConfigurableLanguage;
+use PHPUnit\Framework\Attributes\Group;
+use PHPUnit\Framework\Attributes\RunTestsInSeparateProcesses;
+
+/**
+ * Tests language overrides for config fields.
+ */
+#[Group('field')]
+#[RunTestsInSeparateProcesses]
+class FieldConfigLanguageOverrideTest extends FieldKernelTestBase {
+
+  /**
+   * {@inheritdoc}
+   */
+  protected static $modules = [
+    'entity_test',
+    'field',
+    'language',
+    'options',
+    'system',
+    'user',
+  ];
+
+  /**
+   * The entity field manager.
+   *
+   * @var \Drupal\Core\Entity\EntityFieldManagerInterface
+   */
+  protected EntityFieldManagerInterface $entityFieldManager;
+
+  /**
+   * The language manager.
+   *
+   * @var \Drupal\language\ConfigurableLanguageManagerInterface
+   */
+  protected ConfigurableLanguageManagerInterface $languageManager;
+
+  /**
+   * The bundle used in this test.
+   *
+   * @var string
+   */
+  protected string $testBundle = 'test_bundle';
+
+  /**
+   * {@inheritdoc}
+   */
+  protected function setUp(): void {
+    parent::setUp();
+
+    EntityTestHelper::createBundle($this->testBundle);
+    ConfigurableLanguage::createFromLangcode('af')->save();
+
+    $this->entityFieldManager = $this->container->get('entity_field.manager');
+    $this->languageManager = $this->container->get('language_manager');
+
+    $this->config('language.types')->set('negotiation.language_interface.enabled', [
+      'language-selected' => 0,
+    ])->save();
+    // @todo Remove this in https://www.drupal.org/project/drupal/issues/3544395
+    $this->container->get('language_negotiator')->setCurrentUser($this->container->get('current_user'));
+  }
+
+  /**
+   * Tests a language config override for a base field override.
+   */
+  public function testLanguageConfigOverride(): void {
+    $this->assertEquals('en', $this->languageManager->getCurrentLanguage()->getId());
+    $this->createFieldWithStorage(bundle: $this->testBundle);
+    $fieldConfig = $this->fieldTestData->field;
+    $this->assertInstanceOf(FieldConfig::class, $fieldConfig);
+    $label = $fieldConfig->getLabel();
+    $this->assertTestFieldLabel($label);
+
+    $this->config('language.negotiation')->set('selected_langcode', 'af')->save();
+    $this->languageManager->reset();
+    $this->assertEquals('af', $this->languageManager->getCurrentLanguage()->getId());
+    $languageConfigOverride = $this->languageManager->getLanguageConfigOverride('af', $fieldConfig->getConfigDependencyName());
+    $languageConfigOverride->set('label', "$label (Afrikaans override)")->save();
+    $this->assertTestFieldLabel("$label (Afrikaans override)");
+  }
+
+  /**
+   * Tests translated storage option labels after switching languages.
+   */
+  public function testFieldStorageOptionsAfterLanguageSwitch(): void {
+    $field_name = 'field_status';
+    $english_options = ['draft' => 'Draft', 'published' => 'Published'];
+    $translated_options = [
+      'draft' => 'Draft (Afrikaans override)',
+      'published' => 'Published (Afrikaans override)',
+    ];
+    $storage = FieldStorageConfig::create([
+      'entity_type' => 'entity_test',
+      'field_name' => $field_name,
+      'type' => 'list_string',
+      'settings' => ['allowed_values' => $english_options],
+    ]);
+    $storage->save();
+    FieldConfig::create([
+      'field_storage' => $storage,
+      'bundle' => $this->testBundle,
+      'label' => 'Status',
+    ])->save();
+    $override = $this->languageManager->getLanguageConfigOverride('af', $storage->getConfigDependencyName());
+    $override->set('settings.allowed_values', [
+      ['label' => $translated_options['draft']],
+      ['label' => $translated_options['published']],
+    ])->save();
+    $this->entityFieldManager->clearCachedFieldDefinitions();
+
+    // Keep the same field manager across language changes. A new language must
+    // not reuse storage definitions built with the previous language's labels.
+    foreach (['en', 'af', 'en', 'af'] as $langcode) {
+      $this->config('language.negotiation')->set('selected_langcode', $langcode)->save();
+      $this->languageManager->reset();
+      $this->assertSame($langcode, $this->languageManager->getCurrentLanguage()->getId());
+      $original_override = $this->languageManager->getConfigOverrideLanguage();
+      $expected = $langcode === 'en' ? $english_options : $translated_options;
+      $definitions = $this->entityFieldManager->getFieldStorageDefinitions('entity_test');
+      $this->assertSame($expected, $definitions[$field_name]->getSetting('allowed_values'));
+      $this->assertSame($original_override, $this->languageManager->getConfigOverrideLanguage());
+
+      // Bundle definitions must also retain the correct storage option labels
+      // when they are built and cached under the new language.
+      $fields = $this->entityFieldManager->getFieldDefinitions('entity_test', $this->testBundle);
+      $this->assertSame($expected, $fields[$field_name]->getSetting('allowed_values'));
+    }
+  }
+
+  /**
+   * Asserts that the field label of the test field matches the expected value.
+   *
+   * @param string $expected
+   *   The expected field label.
+   *
+   * @throws \PHPUnit\Framework\ExpectationFailedException
+   */
+  protected function assertTestFieldLabel(string $expected): void {
+    $fieldDefinitions = $this->entityFieldManager->getFieldDefinitions('entity_test', $this->testBundle);
+    $this->assertArrayHasKey($this->fieldTestData->field_name, $fieldDefinitions);
+    $fieldDefinition = $fieldDefinitions[$this->fieldTestData->field_name];
+    $this->assertEquals($expected, (string) $fieldDefinition->getLabel());
+  }
+
+}
