+/**
+ * @file
+ * Styles for the CSN Profile frontend form.
+ */
+
+/* Layout */
+.csn-profile {
+  max-width: 800px;
+  margin: 0 auto;
+  padding: 2rem 1rem;
+}
+
+/* Title */
+.csn-profile__title {
+  font-size: 2rem;
+  font-weight: 700;
+  margin-bottom: 1.5rem;
+  color: var(--bsi-color-typo-primary, #1a1a1a);
+}
+
+/* Sections */
+.csn-profile__section {
+  margin-bottom: 2.5rem;
+}
+
+.csn-profile__section-title {
+  font-size: 1.25rem;
+  font-weight: 700;
+  color: var(--bsi-color-typo-primary, #1a1a1a);
+  margin-bottom: 1rem;
+  padding-bottom: 0.5rem;
+  border-bottom: 1px solid var(--bsi-color-border-muted, #d0d0d0);
+}
+
+/* Banners / Hinweisbanner */
+.csn-profile__banner {
+  padding: 1rem 1.25rem;
+  margin-bottom: 1.5rem;
+  border-radius: 4px;
+  font-size: 0.875rem;
+  line-height: 1.5;
+}
+
